{
  "name": "pcmax",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "db:init": "node server/init-db.js",
    "db:seed-products": "node server/seed-products.js",
    "db:convert-php": "node server/convert-catalog-php.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" index.html vite.config.js package.json README.md",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" index.html vite.config.js package.json README.md",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.0.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "nodemon": "3.1.11",
    "prettier": "^3.10.1",
    "supertest": "^7.0.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.12"
  }
}
