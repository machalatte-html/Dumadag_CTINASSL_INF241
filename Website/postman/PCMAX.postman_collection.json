{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "name": "PCMAX API",
    "description": "Session-based PCMAX API checks for customer and administrator flows. Import `PCMAX.postman_environment.json`, select the **PCMAX Local** environment, start Express (`npm start` or `npm run dev`), and run the collection or each folder.\n\nPrerequisites:\n- MongoDB connected via `MONGODB_URI`\n- `npm run db:init` and `npm run db:seed-products` for catalog data\n- An administrator account (register, then set `role` to `admin` in Atlas) matching `adminEmail` / `adminPassword` in the environment\n\nPostman must store cookies for `pcmax.sid`. Each mutating request sends `X-CSRF-Token` from the latest CSRF or auth response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "customerPassword",
      "value": "correct-horse-battery"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "change-this-before-use"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.environment.get('csrfToken') || pm.collectionVariables.get('csrfToken') || '';",
          "if (token) {",
          "  pm.request.headers.upsert({ key: 'X-CSRF-Token', value: token });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const saveToken = (value) => {",
          "  if (!value) return;",
          "  pm.collectionVariables.set('csrfToken', value);",
          "  if (pm.environment.name) pm.environment.set('csrfToken', value);",
          "};",
          "try {",
          "  const body = pm.response.json();",
          "  saveToken(body && body.csrfToken);",
          "  saveToken(body && body.token);",
          "} catch (_e) { /* non-JSON responses */ }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Customer",
      "description": "Registers a new customer, exercises catalog and checkout, and confirms admin routes are forbidden.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('health is ok', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.brand).to.eql('PCMAX');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('csrf token issued', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().token).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = `postman.customer.${Date.now()}@example.com`;",
                  "pm.collectionVariables.set('customerEmail', email);",
                  "if (pm.environment.name) pm.environment.set('customerEmail', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('customer registration succeeds', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.email).to.eql(pm.environment.get('customerEmail') || pm.collectionVariables.get('customerEmail'));",
                  "  pm.expect(body.user.role).to.eql('customer');",
                  "  pm.expect(body.csrfToken).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"gender\": \"prefer_not_to_say\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
